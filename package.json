{
  "name": "valorant-instalock",
  "version": "1.0.0",
  "description": "VALORANT Agent Selection Companion - Open Source Educational Project",
  "main": "main.js",
  "author": "supidooo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/supidooo/valorant-instalock.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "valorant",
    "instalock",
    "electron",
    "riot-games",
    "riot-api"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "electron": "^44.7.0"
  },
  "build": {
    "appId": "com.supidooo.valorant-instalock",
    "productName": "VALORANT Instalock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "supidooo",
        "repo": "valorant-instalock"
      }
    ]
  }
}
